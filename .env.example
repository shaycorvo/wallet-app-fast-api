APP_ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://wallet:wallet@postgres:5432/wallet
# Pytest derives this as DATABASE_URL with the database name replaced by wallet_test.
TEST_DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5433/wallet_test
JWT_SECRET=replace-with-a-long-local-development-secret
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
TEST_SEED_KEY=set-only-for-local-test-or-demo-deployments